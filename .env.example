# Application Port
PORT=3000

# Base URL for generated short links
BASE_URL=http://localhost:3000

# Storage Engine: 'sqlite' or 'postgres'
DB_TYPE=sqlite
DATABASE_URL=postgres://shortener_user:shortener_pass@localhost:5432/url_shortener

# Redirect Status Code: 302 or 301
REDIRECT_STATUS=302

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Node Configuration
NODE_ID=1
RANGE_STEP=100000
